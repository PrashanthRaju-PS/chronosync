# ChronoSync configuration. Copy to .env and edit.
# Env var format: CHRONOSYNC_<group>__<field>  (double-underscore separates nested fields)

# --- Database ---
CHRONOSYNC_DB__DSN=postgresql+asyncpg://chrono:chrono@localhost:5432/chronosync
CHRONOSYNC_DB__POOL_MIN_SIZE=2
CHRONOSYNC_DB__POOL_MAX_SIZE=20

# --- Vault ---
# backend: local | keyring | hashicorp
CHRONOSYNC_VAULT__BACKEND=local
CHRONOSYNC_VAULT__PATH=./.local/chronosync_vault.enc
CHRONOSYNC_VAULT__MASTER_KEY_ENV=CHRONOSYNC_VAULT_KEY
# The master key itself (do NOT commit). For dev only:
CHRONOSYNC_VAULT_KEY=change-me-to-a-strong-passphrase

# --- Providers ---
CHRONOSYNC_PROVIDERS__DEFAULT_FEED=yfinance
CHRONOSYNC_PROVIDERS__YFINANCE_CONCURRENCY=8
CHRONOSYNC_PROVIDERS__RETRY_MAX_ATTEMPTS=5
CHRONOSYNC_PROVIDERS__RETRY_BASE_DELAY_S=1.0
CHRONOSYNC_PROVIDERS__RETRY_MAX_DELAY_S=30.0

# --- Sync ---
CHRONOSYNC_SYNC__EXCHANGES=["NSE","BSE"]
CHRONOSYNC_SYNC__EOD_CRON=30 18 * * 1-5
CHRONOSYNC_SYNC__SEED_CRON=0 9 * * 1-5
CHRONOSYNC_SYNC__TIMEZONE=Asia/Kolkata
CHRONOSYNC_SYNC__BACKFILL_BATCH_DAYS=30

# --- API ---
CHRONOSYNC_API__HOST=127.0.0.1
CHRONOSYNC_API__PORT=8088
CHRONOSYNC_API__HEALTH_MAX_STALENESS_H=24

# --- Logging ---
CHRONOSYNC_LOGGING__LEVEL=INFO
CHRONOSYNC_LOGGING__JSON_FORMAT=false
CHRONOSYNC_LOGGING__FILE=./.local/logs/chronosync.log
CHRONOSYNC_LOGGING__MAX_BYTES=50000000
CHRONOSYNC_LOGGING__BACKUPS=7
